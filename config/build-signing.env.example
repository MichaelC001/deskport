# Reference only. Do not fill in or source this tracked template.
# Store local values in ~/.config/deskport/build-signing.env with mode 0600.
# That file contains environment settings, never shell commands or private keys.
# Keep certificate private keys and notarization credentials in macOS Keychain.
# Do not copy the local file into a checkout, source archive, release, or log.
DESKPORT_SIGN_IDENTITY=DEVELOPER_ID_CERTIFICATE_SHA1
DESKPORT_SIGN_TEAM=APPLE_TEAM_ID
DESKPORT_NOTARY_PROFILE=YOUR_NOTARY_KEYCHAIN_PROFILE
